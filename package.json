{
  "name": "careledger",
  "version": "0.1.0",
  "description": "Offline-first clinic management system for patients, visits, billing, dispensary, and reports.",
  "author": "PayeConnect Digital Solutions",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test:db": "ELECTRON_RUN_AS_NODE=1 electron test/db.test.js",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.payeconnect.careledger",
    "productName": "CareLedger",
    "icon": "build/icon.png",
    "publish": {
      "provider": "github",
      "owner": "Geejorgbor",
      "repo": "careledger",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.md"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
